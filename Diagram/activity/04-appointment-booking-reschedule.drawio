        <mxCell id="finding1" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=7;" value="&lt;b&gt;Finding 1 — confirmed cancellation defect:&lt;/b&gt; AppointmentController::cancel() checks &lt;b&gt;$hasCompletedPayment&lt;/b&gt; in the confirmed branch before that variable is assigned. The intended confirmed+paid cancellation-request path can therefore fail at runtime until this is fixed." vertex="1">
          <mxGeometry height="92" width="690" x="55" y="1555" as="geometry" />
        </mxCell>
        <mxCell id="finding2" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=7;" value="&lt;b&gt;Finding 2 — doctor reschedule state mismatch:&lt;/b&gt; the doctor-driven &lt;b&gt;decision = reschedule&lt;/b&gt; branch releases the slot and sets &lt;b&gt;rescheduled_at&lt;/b&gt; immediately, but no replacement slot is selected. The patient UI also treats rescheduled_at / reschedule_requested as already rescheduled, so this path can become difficult to complete cleanly." vertex="1">
          <mxGeometry height="92" width="710" x="810" y="1555" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#334155;" value="Figure 4.8C  Swimlane Diagram — Doctor Decision, Rescheduling and Cancellation" vertex="1">
          <mxGeometry height="28" width="1000" x="300" y="1725" as="geometry" />
        </mxCell>
      </root>
