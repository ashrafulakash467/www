        <mxCell id="a_note" value="&lt;b&gt;Also present:&lt;/b&gt; Spatie Permission tables for roles/permissions, Laravel sessions/password reset tokens, Sanctum personal access tokens, cache/jobs tables. These framework infrastructure tables are intentionally omitted from the visual ERD to keep the application-domain model readable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="900" width="900" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a_note2" value="&lt;b&gt;Support ticket foreign keys:&lt;/b&gt; support_tickets can additionally reference patient_id and doctor_id. They are not drawn as separate entities on this page because those profiles are already shown in the Core ERD." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="1000" width="820" height="65" as="geometry" />
        </mxCell>
